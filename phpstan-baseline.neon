parameters:
	ignoreErrors:
		-
			message: '#^Anonymous function has an unused use \$scan\.$#'
			identifier: closure.unusedUse
			count: 1
			path: src/BuildCommand.php

		-
			message: '#^Constant ROOT_DIR not found\.$#'
			identifier: constant.notFound
			count: 3
			path: src/BuildCommand.php

		-
			message: '#^Parameter \#1 \$hooks of method Leaf\\BuildCommand\:\:runPostBuildHooks\(\) expects list\<list\<string\>\>, list\<list\<string\>\|string\> given\.$#'
